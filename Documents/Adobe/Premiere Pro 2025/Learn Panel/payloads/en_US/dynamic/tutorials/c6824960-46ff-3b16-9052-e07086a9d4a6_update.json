            "sizeBytes": "123456789",
            "steps": [
                {
                    "stepItems": [
                        {
                            "autoplay": true,
                            "type": "video",
                            "videoUrl": "https://helpx.adobe.com/content/dam/help/en/premiere-pro/how-to/in-app/save-export-share-travel-video/0164742f-f4ad-4eb3-84ec-639a4b5de174.mp4"
                        },
                        {
                            "text": "Export your film",
                            "type": "heading"
                        },
                        {
                            "text": "Using the right export settings is a key part of making sure your film turns out exactly how you want it.",
                            "type": "text"
                        },
                        {
                            "listItems": [
                                {
                                    "text": "In the timeline, set an in point at the beginning of your film by moving the playhead to the start and pressing <%I%>."
                                },
                                {
                                    "text": "Move the playhead to the end of your film and press <%O%> to set an out point."
                                },
                                {
                                    "text": "Select the <$Export$> button at the bottom of the window and wait for your video to render."
                                }
                            ],
                            "type": "listSubsteps"
                        },
                        {
                            "texts": [
                                "<$Please note:$> Switching to <$Export$> mode will close the learn panel and hide this tutorial. Switching back to <$Edit$> mode will reopen this tutorial where you left off. Consider taking a screenshot or writing down the steps below."
                            ],
                            "type": "well",
                            "wellType": "info"
                        },
                        {
                            "listItems": [
                                {
                                    "text": "Switch to <$Export$> mode and use the following setting:<ul><li><$File Name$><li><$Location$><li><$Preset$>, choose <$Custom$><li><$Format$>, choose <$H.264$><li><$Frame Size$></li></ul>"
                                },
                                {
                                    "text": "In the <$Video$> settings section, choose <$Match Source$>."
                                },
                                {
                                    "text": "Select the <$Export$> button at the bottom of the window and wait for your video to render."
                                },
                                {
                                    "text": "Switch back to <$Edit$> mode to learn how to publish your video to your social platforms."
                                }
                            ],
                            "type": "listSubsteps"
                        }
                    ]
                },
                {
                    "stepItems": [
                        {
                            "autoplay": true,
                            "type": "video",
                            "videoUrl": "https://helpx.adobe.com/content/dam/help/en/premiere-pro/how-to/in-app/save-export-share-travel-video/964f247e-8fa4-406b-ab76-29db7d6b506a.mp4"
                        },
                        {
                            "text": "Publish to your social media platforms",
                            "type": "heading"
                        },
                        {
                            "text": "Watch James's video and then take a screenshot of the steps below to try uploading your video to your YouTube channel. Remember, switching to <$Export$> mode will close the <$Learn$> panel and hide this tutorial.",
                            "type": "text"
                        },
                        {
                            "listItems": [
                                {
                                    "text": "In <$Export$> mode, enable uploading to <$YouTube$> from the sidebar. If needed, click <$Sign In$> to access your account."
                                },
                                {
                                    "text": "Add your video <$Title$> and <$Description$>."
                                },
                                {
                                    "text": "Update the other options like <$Playlist$>, <$Privacy Settings$>, or <$Tags$>."
                                },
                                {
                                    "text": "If you want, add a <$Custom Thumbnail$> using the drop down. You can add a still from your video or upload a thumbnail from a file."
                                },
                                {
                                    "text": "Repeat these steps for any other platforms you want to upload to."
                                },
                                {
                                    "text": "Click the blue <$Export$> button to export your video and upload it to YouTube and any other social destinations you enabled."
                                }
                            ],
                            "type": "listSubsteps"
                        }
                    ]
                },
                {
                    "stepItems": [
                        {
                            "successHeading": "Congrats!",
                            "successText": "You've successfully edited a cinematic travel video. Be sure to practice these skills in your own projects and keep learning with other tutorials.",
                            "type": "endScreen"
                        }
                    ]
                }
            ]
