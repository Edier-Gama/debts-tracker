            "sizeBytes": "123456789",
            "steps": [
                {
                    "stepItems": [
                        {
                            "autoplay": true,
                            "type": "video",
                            "videoUrl": "https://helpx.adobe.com/content/dam/help/en/premiere-pro/how-to/in-app/try-generative-extend/19688465-9d1b-446e-a4b4-b0dd7eb86d4f.mp4"
                        },
                        {
                            "text": "Increase scene tension with extra frames",
                            "type": "heading"
                        },
                        {
                            "text": "Try adding a few frames to the clip using <$Generative Extend$>.",
                            "type": "text"
                        },
                        {
                            "listItems": [
                                {
                                    "text": "In the toolbar, select the <$Generative Extend$> tool."
                                },
                                {
                                    "checkUserInteractions": [
                                        {
                                            "check": "clipAdded",
                                            "payload": {
                                                "clipName": "Suspense_in_Space18_0112PI-extended"
                                            }
                                        }
                                    ],
                                    "text": "Drag the end of the clip until it fills the gap. Then, wait a moment for the new frames to generate."
                                },
                                {
                                    "checkUserInteractions": [
                                        {
                                            "check": "ctiMoved"
                                        }
                                    ],
                                    "showOnComplete": {
                                        "heading": "Amazing!",
                                        "texts": [
                                            "Great job using <$Generative Extend$> to increase the intensity of this scene. The suspense really builds by holding that clip just a few frames longer."
                                        ]
                                    },
                                    "text": "Press the <%{KEY.SPACEBAR}%> to watch the scene with the newly generated frames."
                                }
                            ],
                            "type": "listSubsteps"
                        }
                    ]
                },
                {
                    "stepActionsOnShow": [
                        {
                            "actionName": "openSequenceByName",
                            "payload": {
                                "sequenceName": "Generative Extend 2"
                            }
                        }
                    ],
                    "stepItems": [
                        {
                            "autoplay": true,
                            "type": "video",
                            "videoUrl": "https://helpx.adobe.com/content/dam/help/en/premiere-pro/how-to/in-app/try-generative-extend/e738fa4b-7353-4b3c-8689-f5543a0b5a96.mp4"
                        },
                        {
                            "text": "Fix an awkward end point",
                            "type": "heading"
                        },
                        {
                            "text": "Try using <$Generative Extend$> to replace the frames at the end of this clip so that the interviewee doesn't continue talking as the logo fades in.",
                            "type": "text"
                        },
                        {
                            "listItems": [
                                {
                                    "checkUserInteractions": [
                                        {
                                            "check": "ctiMoved"
                                        }
                                    ],
                                    "text": "Press the <%{KEY.SPACEBAR}%> to watch the original edit for this promotion."
                                },
                                {
                                    "checkUserInteractions": [
                                        {
                                            "check": "clipLengthChanged",
                                            "payload": {
                                                "clipName": "DRYP_Interview.mp4"
                                            }
                                        }
                                    ],
                                    "text": "Using the <$Selection$> tool, trim the clip to the green marker at the end of the usable footage."
                                },
                                {
                                    "checkUserInteractions": [
                                        {
                                            "check": "clipAdded",
                                            "payload": {
                                                "clipName": "DRYP_Interview-extended"
                                            }
                                        }
                                    ],
                                    "text": "Choose the <$Generative Extend$> tool and drag the end of the clip forward to the teal marker, where the cross dissolve ends. Wait for the new frames to generate."
                                },
                                {
                                    "checkUserInteractions": [
                                        {
                                            "check": "ctiMoved"
                                        }
                                    ],
                                    "showOnComplete": {
                                        "heading": "Fantastic!",
                                        "texts": [
                                            "<$Generative Extend$> can be used at any edit point to perfect your edits. The new frames at the end of this interview clip have made it much more usable as a promotional video."
                                        ]
                                    },
                                    "text": "Watch the sequence back and look for the differences."
                                }
                            ],
                            "type": "listSubsteps"
                        }
                    ]
                },
                {
                    "stepActionsOnShow": [
                        {
                            "actionName": "openSequenceByName",
                            "payload": {
                                "sequenceName": "Generative Extend 3"
                            }
                        }
                    ],
                    "stepItems": [
                        {
                            "autoplay": true,
                            "type": "video",
                            "videoUrl": "https://helpx.adobe.com/content/dam/help/en/premiere-pro/how-to/in-app/try-generative-extend/47b6beb0-8149-47c5-ac5c-8a84041bdc98.mp4"
                        },
                        {
                            "text": "Extend audio clips",
                            "type": "heading"
                        },
                        {
                            "text": "Try using <$Generative Extend$> to extend the video and audio of this clip.",
                            "type": "text"
                        },
                        {
                            "listItems": [
                                {
                                    "checkUserInteractions": [
                                        {
                                            "check": "clipAdded",
                                            "payload": {
                                                "clipName": "Iceberg-extended"
                                            }
                                        }
                                    ],
                                    "text": "Using the <$Generative Extend$> tool, drag the end of the clip so that it generates two seconds of new frames."
                                },
                                {
                                    "checkUserInteractions": [
                                        {
                                            "check": "ctiMoved"
                                        }
                                    ],
                                    "showOnComplete": {
                                        "heading": "Awesome!",
                                        "texts": [
                                            "The generated audio seamlessly blends with the recorded audio. You can use <$Generative Extend$> to fill in background noise and sound effects when working on your video projects."
                                        ]
                                    },
                                    "text": "Press the <%{KEY.SPACEBAR}%> to watch the clip with the new generated frames."
                                }
                            ],
                            "type": "listSubsteps"
                        },
                        {
                            "texts": [
                                "You can view the most up-to-date media requirements on <a href=\"https://helpx.adobe.com/premiere-pro/using/generative-extend.html\">Adobe HelpX</a>."
                            ],
                            "type": "well",
                            "wellType": "info"
                        }
                    ]
                },
                {
                    "stepItems": [
                        {
                            "successHeading": "Great job!",
                            "successText": "Try using <$Generative Extend$> in your projects when you need to add a few frames to add suspense, extend background sound, cover a transition, or create the perfect cut.",
                            "type": "endScreen"
                        }
                    ]
                }
            ]
